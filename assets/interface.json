{
  "interface_version": 2,
  "name": "GBFRLinux",
  "label": "GBFR 自动刷取",
  "version": "0.1.0-dev",
  "license": "GPL-2.0-or-later",
  "description": "简体中文界面；单人任务与 AI 队友。当前预设处于验证中。",
  "controller": [
    {
      "name": "GBFR Gamescope",
      "type": "Linux",
      "display_short_side": 720,
      "linux": {
        "screencap": "PipeWire",
        "input": "Libei",
        "pipewire_source": "Gamescope",
        "use_win32_vk_code": false
      }
    }
  ],
  "resource": [
    {
      "name": "简体中文 720p",
      "path": [
        "./resource"
      ]
    }
  ],
  "agent": {
    "child_exec": "./.venv/bin/python",
    "child_args": [
      "-B",
      "./agent/maa_agent.py"
    ]
  },
  "task": [
    {
      "name": "quakadile-materials",
      "label": "巨爪岩鳄素材",
      "entry": "GBFR_Start",
      "description": "任务：解决沙漠狂徒。MANIAC，推荐战力 7200。需要解锁任务、开启完全辅助模式，且当前 AI 队伍能稳定通关。从希德霍姆城镇或任务中心开始，完成后返回城镇。\n\n此预设仍在验证，请先用 1 次确认当前队伍能够完成。一次只勾选一个预设。 [查看进度和停止](http://127.0.0.1:12792/api/local-file?path=control.html)",
      "option": [
        "Runs"
      ],
      "pipeline_override": {
        "GBFR_Catalog_NameList": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameDetails": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameReady": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameConfirm": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameResult": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_ObjectiveDetails": {
          "expected": "讨伐巨爪岩鳄"
        },
        "GBFR_Catalog_ObjectiveBattle": {
          "expected": "讨伐巨爪岩鳄"
        },
        "GBFR_QuestConfig": {
          "attach": {
            "quest": "解决沙漠狂徒"
          }
        }
      }
    },
    {
      "name": "frost-quakadile-materials",
      "label": "巨爪霜鳄素材",
      "entry": "GBFR_Start",
      "description": "任务：我要打造冰冷的铠甲。MANIAC，推荐战力 7200。需要解锁任务、开启完全辅助模式，且当前 AI 队伍能稳定通关。从希德霍姆城镇或任务中心开始，完成后返回城镇。\n\n此预设仍在验证，请先用 1 次确认当前队伍能够完成。一次只勾选一个预设。 [查看进度和停止](http://127.0.0.1:12792/api/local-file?path=control.html)",
      "option": [
        "Runs"
      ],
      "pipeline_override": {
        "GBFR_Catalog_NameList": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameDetails": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameReady": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameConfirm": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameResult": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_ObjectiveDetails": {
          "expected": "讨伐巨爪霜鳄"
        },
        "GBFR_Catalog_ObjectiveBattle": {
          "expected": "讨伐巨爪霜鳄"
        },
        "GBFR_QuestConfig": {
          "attach": {
            "quest": "我要打造冰冷的铠甲"
          }
        }
      }
    }
  ],
  "option": {
    "Runs": {
      "type": "select",
      "label": "成功通关次数",
      "default_case": "1",
      "cases": [
        {
          "name": "1",
          "pipeline_override": {
            "GBFR_RunLimit": {
              "attach": {
                "limit": 1
              }
            }
          }
        },
        {
          "name": "3",
          "pipeline_override": {
            "GBFR_RunLimit": {
              "attach": {
                "limit": 3
              }
            }
          }
        },
        {
          "name": "10",
          "pipeline_override": {
            "GBFR_RunLimit": {
              "attach": {
                "limit": 10
              }
            }
          }
        },
        {
          "name": "30",
          "pipeline_override": {
            "GBFR_RunLimit": {
              "attach": {
                "limit": 30
              }
            }
          }
        },
        {
          "name": "999",
          "pipeline_override": {
            "GBFR_RunLimit": {
              "attach": {
                "limit": 999
              }
            }
          }
        }
      ]
    }
  },
  "welcome": "[查看进度、选择本轮后停止](http://127.0.0.1:12792/api/local-file?path=control.html)"
}
