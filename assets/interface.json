{
  "interface_version": 2,
  "name": "GBFRLinux",
  "label": "GBFR 自动刷取",
  "version": "0.2.0-dev",
  "license": "GPL-2.0-or-later",
  "description": "简体中文界面；单人任务与 AI 队友。用游戏自带的“再次挑战”连刷，两个素材预设；可设成功次数或一直刷，可选择本轮后停止。",
  "controller": [
    {
      "name": "GBFR Gamescope",
      "type": "Linux",
      "display_short_side": 720,
      "linux": {
        "screencap": "PipeWire",
        "input": "Libei",
        "pipewire_source": "Gamescope",
        "use_win32_vk_code": false
      }
    }
  ],
  "resource": [
    {
      "name": "简体中文 720p",
      "path": [
        "./resource"
      ]
    }
  ],
  "agent": {
    "child_exec": "./.venv/bin/python",
    "child_args": [
      "-B",
      "./agent/maa_agent.py"
    ]
  },
  "task": [
    {
      "name": "quakadile-materials",
      "label": "巨爪岩鳄素材",
      "entry": "GBFR_Start",
      "description": "任务：解决沙漠狂徒（MANIAC，推荐战力 7200）。\n需要：任务已解锁；开启完全辅助模式；当前 AI 队伍能稳定通关。\n从城镇或这个任务的准备画面开始。软件接第一次任务，之后打开游戏自带的“再次挑战”连刷；游戏每 10 次弹出确认时，软件回城重新接任务。达到次数或你选择本轮后停止时，软件关掉再次挑战，等游戏回到城镇后结束。\n第一次使用请先填 1 次，确认队伍能过。一次只勾选一个预设。",
      "option": [
        "UntilStopped"
      ],
      "pipeline_override": {
        "GBFR_Catalog_NameList": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameDetails": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameReady": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameConfirm": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_NameResult": {
          "expected": "解决沙漠狂徒"
        },
        "GBFR_Catalog_ObjectiveDetails": {
          "expected": "讨伐巨爪岩鳄"
        },
        "GBFR_Catalog_ObjectiveBattle": {
          "expected": "讨伐巨爪岩鳄"
        },
        "GBFR_QuestConfig": {
          "attach": {
            "quest": "解决沙漠狂徒",
            "battle_limit": 600
          }
        }
      }
    },
    {
      "name": "frost-quakadile-materials",
      "label": "巨爪霜鳄素材",
      "entry": "GBFR_Start",
      "description": "任务：我要打造冰冷的铠甲（MANIAC，推荐战力 7200）。\n需要：任务已解锁；开启完全辅助模式；当前 AI 队伍能稳定通关。\n从城镇或这个任务的准备画面开始。软件接第一次任务，之后打开游戏自带的“再次挑战”连刷；游戏每 10 次弹出确认时，软件回城重新接任务。达到次数或你选择本轮后停止时，软件关掉再次挑战，等游戏回到城镇后结束。\n第一次使用请先填 1 次，确认队伍能过。一次只勾选一个预设。",
      "option": [
        "UntilStopped"
      ],
      "pipeline_override": {
        "GBFR_Catalog_NameList": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameDetails": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameReady": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameConfirm": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_NameResult": {
          "expected": "我要打造冰冷的铠甲"
        },
        "GBFR_Catalog_ObjectiveDetails": {
          "expected": "讨伐巨爪霜鳄"
        },
        "GBFR_Catalog_ObjectiveBattle": {
          "expected": "讨伐巨爪霜鳄"
        },
        "GBFR_QuestConfig": {
          "attach": {
            "quest": "我要打造冰冷的铠甲",
            "battle_limit": 600
          }
        }
      }
    }
  ],
  "option": {
    "UntilStopped": {
      "type": "switch",
      "label": "一直刷，直到我停止",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "GBFR_UntilStopped": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "GBFR_UntilStopped": {
              "enabled": false
            }
          },
          "option": [
            "Runs"
          ]
        }
      ]
    },
    "Runs": {
      "type": "input",
      "inputs": [
        {
          "name": "Runs",
          "label": "成功次数",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^[1-9][0-9]{0,2}$",
          "pattern_msg": "请输入 1 到 999 的整数"
        }
      ],
      "pipeline_override": {
        "GBFR_RunLimit": {
          "attach": {
            "limit": "{Runs}"
          }
        }
      }
    }
  },
  "welcome": "进度和“本轮后停止”在[控制面板](http://127.0.0.1:12792/api/local-file?path=control.html)。"
}
